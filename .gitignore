# ==========================================
# ファイルタイムマシン 完全ホワイトリスト方式 .gitignore
# ==========================================

# 1. デフォルトですべてのファイルを無視
*

# 2. ルートディレクトリで例外許可するファイル
!.gitignore
!README.md
!LICENSE
!NOTICE.md
!app-icon.png
!.github/
!.github/**
!変数関数仕様書.md

# 3. app-file-timemachine（フロントエンドとTauri共通部）の例外許可
!app-file-timemachine/
!app-file-timemachine/package.json
!app-file-timemachine/package-lock.json
!app-file-timemachine/tsconfig.json
!app-file-timemachine/tsconfig.node.json
!app-file-timemachine/vite.config.ts
!app-file-timemachine/index.html

# フロントエンドのソースコードおよびアセット
!app-file-timemachine/public/
!app-file-timemachine/public/**
!app-file-timemachine/src/
!app-file-timemachine/src/**

# 4. src-tauri（Rustバックエンド）の例外許可
!app-file-timemachine/src-tauri/
!app-file-timemachine/src-tauri/Cargo.toml
!app-file-timemachine/src-tauri/Cargo.lock
!app-file-timemachine/src-tauri/build.rs
!app-file-timemachine/src-tauri/tauri.conf.json

# バックエンドのソースコード、アイコン、Tauri V2権限設定
!app-file-timemachine/src-tauri/capabilities/
!app-file-timemachine/src-tauri/capabilities/**
!app-file-timemachine/src-tauri/icons/
!app-file-timemachine/src-tauri/icons/**
!app-file-timemachine/src-tauri/src/
!app-file-timemachine/src-tauri/src/**